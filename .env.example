# CampusCycle — Docker Deployment Environment Variables Example
# Copy this file to .env before starting containers if custom values are needed.
# Do NOT commit production secrets to version control.

# Application Environment (development | production)
CC_ENVIRONMENT=development
CC_APP_NAME=CampusCycle API
CC_LOG_LEVEL=INFO
CC_API_V1_PREFIX=/api/v1

# Service Ports (host-mapped)
# Access the web UI at http://localhost:5173 (or change to 80 for standard HTTP)
CC_FRONTEND_PORT=5173
# Backend loopback binding (direct access for development/debugging)
CC_BACKEND_PORT=127.0.0.1:8000

# CORS Allowed Origins (JSON array format)
CC_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost","http://127.0.0.1"]

# SQLite Database & Persistent Storage (stored inside named volume mounted at /data)
CC_DATABASE_URL=sqlite:////data/campuscycle.db
CC_RESOURCE_IMAGE_DIR=/data/uploads/resource-images

# Authentication & JWT Configuration
# In production, replace with random secrets of at least 32 characters
CC_JWT_SECRET_KEY=local-compose-development-only-change-me
CC_JWT_ALGORITHM=HS256
CC_JWT_ISSUER=campuscycle-api
CC_JWT_AUDIENCE=campuscycle-client
CC_ACCESS_TOKEN_EXPIRE_MINUTES=15
CC_REFRESH_TOKEN_EXPIRE_DAYS=7

# CSRF & Cookie Configuration
CC_CSRF_SECRET_KEY=local-compose-development-only-csrf-change-me
CC_REFRESH_COOKIE_NAME=campuscycle_refresh
CC_CSRF_COOKIE_NAME=campuscycle_csrf
CC_AUTH_COOKIE_PATH=/api/v1/auth
CC_CSRF_COOKIE_PATH=/
# Set CC_COOKIE_SECURE=true when running behind HTTPS in production
CC_COOKIE_SECURE=false
CC_COOKIE_SAMESITE=lax
